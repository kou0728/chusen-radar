# 母艦の ~/.config/chusen-android.env にコピーして書き換えてください。
#   cp android_agent/agent.env.example ~/.config/chusen-android.env && chmod 600 ~/.config/chusen-android.env
# このファイル（コピー後のもの）は GitHub に上げないこと。

# 必須：結果を GitHub に送るためのトークン
#   GitHub → Settings → Developer settings → Fine-grained tokens → Generate new token
#   Repository access: Only select repositories → chusen-radar
#   Permissions: Contents → Read and write（ほかは不要）  有効期限: 1年など
GITHUB_TOKEN=github_pat_ここに貼る
GITHUB_REPO=kou0728/chusen-radar
GITHUB_BRANCH=main

# 任意：端末の不調（つながらない・アプリが読めない）を Discord に知らせる
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 任意・有料：画像だけの告知を Claude API で読む（config/apps.yaml の vision: true と一緒に）
# ANTHROPIC_API_KEY=sk-ant-...

# 端末を2台以上つなぐ時だけ（adb devices で出るシリアル）
# ANDROID_SERIAL=XXXXXXXX
