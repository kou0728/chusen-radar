# iMac の ~/.config/mobilerun-hub.env（chmod 600 ~/.config/mobilerun-hub.env）

# 中継サーバーの管理API。hub は VPS の Tailscale 上の名前（tailscale up --hostname hub で付けた名前）
HUB_ADMIN_URL=http://hub:8701
# VPS の /etc/mobilerun-hub.env と同じ管理トークン
HUB_ADMIN_TOKEN=

# Portal が入っていない端末に入れる、公式 Mobilerun Portal の APK
PORTAL_APK=/Users/自分の名前/Downloads/mobilerun-portal.apk
