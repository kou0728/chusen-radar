# VPS の /etc/mobilerun-hub.env（sudo chmod 600 /etc/mobilerun-hub.env）

# 端末から見た接続先（Caddyfile のドメインと同じ）
HUB_PUBLIC_URL=wss://portal.example.jp

# 管理トークン： /opt/mobilerun-hub/.venv/bin/python -m mobilerun_hub token の結果を貼る
HUB_ADMIN_TOKEN=

# 管理画面・管理APIを開く場所：VPS の Tailscale の IP（tailscale ip -4 で出る 100.x.y.z）
HUB_ADMIN_HOST=100.64.0.1
HUB_ADMIN_PORT=8701

# 端末の受け口（Caddy から転送される。変えなくてよい）
HUB_PUBLIC_HOST=127.0.0.1
HUB_PUBLIC_PORT=8700
HUB_DATA_DIR=/var/lib/mobilerun-hub

# 任意：切断が続いた時・復帰した時に Discord へ知らせる
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# HUB_ALERT_AFTER_SECONDS=120

# 任意：見張り役アプリがつながっている端末を、Portal が5分切れたら自動で立て直す（1時間に3回まで）
# HUB_AUTO_RECOVER=1
# HUB_RECOVER_AFTER_SECONDS=300
# HUB_RECOVER_PER_HOUR=3
